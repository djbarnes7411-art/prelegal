{
  "slug": "ai-addendum",
  "clauses": [
    {
      "number": "1",
      "depth": 0,
      "heading": "AI Services",
      "segments": []
    },
    {
      "number": "1.1",
      "depth": 1,
      "heading": "Using AI Services",
      "segments": [
        {
          "kind": "text",
          "text": "The AI Services are part of the Product and subject to the Agreement as supplemented by this AI Addendum. "
        },
        {
          "kind": "variable",
          "text": "Customer",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " may use AI Services by providing Input. The AI Services may generate Output in response to Input. "
        },
        {
          "kind": "variable",
          "text": "Provider",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " may copy, display, modify, distribute, and use Input to the extent necessary to provide the AI Services as contemplated by this AI Addendum. "
        },
        {
          "kind": "variable",
          "text": "Customer",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " authorizes "
        },
        {
          "kind": "variable",
          "text": "Provider",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " to process Input for all such purposes."
        }
      ]
    },
    {
      "number": "1.2",
      "depth": 1,
      "heading": "Restrictions",
      "segments": [
        {
          "kind": "text",
          "text": "Without limiting the restrictions contained in the Agreement, "
        },
        {
          "kind": "variable",
          "text": "Customer",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " will not (and will not allow anyone else to): (a) use the AI Services for decision-making in a regulated industry or capacity without proper human oversight and review in compliance with Applicable Laws and applicable professional ethics, guidelines, and rules; (b) use the AI Services to violate, misappropriate, or otherwise infringe the intellectual property or other proprietary rights of others; or (c) falsely state Output was created by a human."
        }
      ]
    },
    {
      "number": "1.3",
      "depth": 1,
      "heading": "Model Training",
      "segments": [
        {
          "kind": "text",
          "text": "Unless the Cover Page identifies "
        },
        {
          "kind": "variable",
          "text": "Training Data",
          "key": "trainingData"
        },
        {
          "kind": "text",
          "text": " and "
        },
        {
          "kind": "variable",
          "text": "Training Purposes",
          "key": "trainingPurposes"
        },
        {
          "kind": "text",
          "text": ", "
        },
        {
          "kind": "variable",
          "text": "Provider",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " may not use "
        },
        {
          "kind": "variable",
          "text": "Customer's",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " Inputs or Outputs to Train any Model. If the Cover Page permits Training, then subject to the "
        },
        {
          "kind": "variable",
          "text": "Training Restrictions",
          "key": "trainingRestrictions"
        },
        {
          "kind": "text",
          "text": ", "
        },
        {
          "kind": "variable",
          "text": "Provider",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " may copy, modify, distribute, and use "
        },
        {
          "kind": "variable",
          "text": "Training Data",
          "key": "trainingData"
        },
        {
          "kind": "text",
          "text": " for the "
        },
        {
          "kind": "variable",
          "text": "Training Purposes",
          "key": "trainingPurposes"
        },
        {
          "kind": "text",
          "text": "."
        }
      ]
    },
    {
      "number": "1.4",
      "depth": 1,
      "heading": "Non-Training Improvement",
      "segments": [
        {
          "kind": "text",
          "text": "Subject to the "
        },
        {
          "kind": "variable",
          "text": "Improvement Restrictions",
          "key": "improvementRestrictions"
        },
        {
          "kind": "text",
          "text": ", "
        },
        {
          "kind": "variable",
          "text": "Provider",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " may use Input, Output, and "
        },
        {
          "kind": "variable",
          "text": "Training Data",
          "key": "trainingData"
        },
        {
          "kind": "text",
          "text": " to provide, maintain, develop, and improve the AI System, provided that such usage does not constitute Training except to the extent authorized for "
        },
        {
          "kind": "variable",
          "text": "Training Purposes",
          "key": "trainingPurposes"
        },
        {
          "kind": "text",
          "text": "."
        }
      ]
    },
    {
      "number": "2",
      "depth": 0,
      "heading": "Intellectual Property and Privacy",
      "segments": []
    },
    {
      "number": "2.1",
      "depth": 1,
      "heading": "Ownership",
      "segments": [
        {
          "kind": "text",
          "text": "As between the parties, "
        },
        {
          "kind": "variable",
          "text": "Customer",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " (a) retains all right, title, and interest in and to all Input, and (b) owns all Output. To the extent permitted by Applicable Laws, "
        },
        {
          "kind": "variable",
          "text": "Provider",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " hereby assigns to "
        },
        {
          "kind": "variable",
          "text": "Customer",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " all right, title, and interest—if any—in and to Output."
        }
      ]
    },
    {
      "number": "2.2",
      "depth": 1,
      "heading": "Personal Data",
      "segments": [
        {
          "kind": "text",
          "text": "Nothing in this AI Addendum will reduce or limit "
        },
        {
          "kind": "variable",
          "text": "Provider's",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " obligations under Applicable Data Protection Laws regarding Personal Data that may be contained in Input."
        }
      ]
    },
    {
      "number": "2.3",
      "depth": 1,
      "heading": "Rights to Input",
      "segments": [
        {
          "kind": "variable",
          "text": "Customer",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " represents and warrants that it, all Users, and anyone submitting Input each have and will continue to have all rights necessary to submit Input to the AI Services."
        }
      ]
    },
    {
      "number": "3",
      "depth": 0,
      "heading": "Disclaimers",
      "segments": []
    },
    {
      "number": "3.1",
      "depth": 1,
      "heading": "Nature of AI",
      "segments": [
        {
          "kind": "text",
          "text": "Due to the nature of artificial intelligence and machine learning, information generated by the AI Services may be incorrect or inaccurate. The AI Services are not human and are not a substitute for human oversight. Output generated by the AI Services may not be protectable as intellectual property."
        }
      ]
    },
    {
      "number": "3.2",
      "depth": 1,
      "heading": "Similarity of Output",
      "segments": [
        {
          "kind": "text",
          "text": "Output may resemble or be duplicative of data, information, and materials created by the AI Services for others. "
        },
        {
          "kind": "variable",
          "text": "Provider",
          "key": "provider"
        },
        {
          "kind": "text",
          "text": " does not provide any representation or warranty that Output (a) does not and will not incorporate or reflect the data, information, prompts, or materials of others, (b) will not violate, misappropriate, or otherwise infringe upon the intellectual property or other proprietary rights of another person or entity, or (c) will not be reproduced in the same or similar way to another user of the AI Services."
        }
      ]
    },
    {
      "number": "4",
      "depth": 0,
      "heading": "Definitions",
      "segments": []
    },
    {
      "number": "4.1",
      "depth": 1,
      "heading": null,
      "segments": [
        {
          "kind": "text",
          "text": "\"AI Addendum Standard Terms\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " means these Common Paper AI Addendum Standard Terms Version 1.0, which are posted at https://commonpaper.com/standards/ai-addendum/1.0/."
        }
      ]
    },
    {
      "number": "4.2",
      "depth": 1,
      "heading": null,
      "segments": [
        {
          "kind": "text",
          "text": "\"AI Services\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " means the artificial intelligence or machine learning components of the Product, including the AI System and underlying Model(s)."
        }
      ]
    },
    {
      "number": "4.3",
      "depth": 1,
      "heading": null,
      "segments": [
        {
          "kind": "text",
          "text": "\"AI System\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " means the artificial intelligence or machine learning application, program, and services layers of the AI Services, excluding the underlying Models."
        }
      ]
    },
    {
      "number": "4.4",
      "depth": 1,
      "heading": null,
      "segments": [
        {
          "kind": "text",
          "text": "\"Input\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " means the data, information, prompts, or materials submitted by or on behalf of "
        },
        {
          "kind": "variable",
          "text": "Customer",
          "key": "customer"
        },
        {
          "kind": "text",
          "text": " or Users to the AI Services but excludes Feedback."
        }
      ]
    },
    {
      "number": "4.5",
      "depth": 1,
      "heading": null,
      "segments": [
        {
          "kind": "text",
          "text": "\"Model\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " means a large language, machine learning, or artificial intelligence model."
        }
      ]
    },
    {
      "number": "4.6",
      "depth": 1,
      "heading": null,
      "segments": [
        {
          "kind": "text",
          "text": "\"Output\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " means the data, information, or materials created by the AI Services in response to Input."
        }
      ]
    },
    {
      "number": "4.7",
      "depth": 1,
      "heading": null,
      "segments": [
        {
          "kind": "text",
          "text": "\"Train\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " or "
        },
        {
          "kind": "text",
          "text": "\"Training\"",
          "strong": true
        },
        {
          "kind": "text",
          "text": " means the use of data, information, or materials to create or improve a Model."
        }
      ]
    }
  ]
}
